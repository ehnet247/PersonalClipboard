  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipboardConfigForm\ClipboardConfigForm.csproj" />
    <ProjectReference Include="..\ClipboardDataManager\ClipboardData.csproj" />
  </ItemGroup>

</Project>