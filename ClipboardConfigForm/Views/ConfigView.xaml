<local:MyWindow x:Class="ClipboardConfigForm.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClipboardConfigForm.Views"
        xmlns:vm="clr-namespace:ClipboardConfigForm.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Title="Personal Clipboard Configuration" Busy="{Binding Busy, Mode=TwoWay}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Row 0, column 0: Phrase list -->
            <DockPanel Grid.Row="0" Grid.Column="0">
            <Label Content="Phrases:" DockPanel.Dock="Top"/>
            <Grid DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Button Content="+" Command="{Binding AddCommand}" BorderThickness="0" Width="20" Height="25" Margin="0,0,2,0"/>
                        <Button Content="-" Command="{Binding RemCommand}" BorderThickness="0" Width="20" Height="25" Margin="2,0,0,0"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1">
                        <ListView ItemsSource="{Binding Phrases}" SelectedItem="{Binding SelectedPhrase}" Background="#f2f2f2" DockPanel.Dock="Top" MinHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Grid>
            </DockPanel>
            <!-- Row 0, column 1: Phrase edition -->
        <Grid Grid.Row="0" Grid.Column="1">
            <GroupBox Header="Edition">
                <StackPanel>
                    <Label Content="Name:"/>
                    <TextBox Text="{Binding EditingPhraseName}"  Width="100" HorizontalAlignment="Left"/>
                    <Label Content="Text:"/>
                    <TextBox Text="{Binding EditingPhraseContent}" Width="Auto" MinWidth="200" HorizontalAlignment="Left"/>
                    <CheckBox Content="Secret" IsChecked="{Binding EditingPhraseIsSecret}" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>
        </Grid>
        <!-- Row 1, columns 0 & 1: Button bar-->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
            <Separator Margin="0,5,0,0"/>
            <UniformGrid Columns="3" Rows="1" Height="30" Margin="5" VerticalAlignment="Bottom">
                <Button Content="Validate" Command="{Binding ValidateCommand}" Background="DeepSkyBlue" BorderThickness="0"  Width="80"/>
                <Button Content="New" Visibility="Hidden" Width="80"/>
                <Button Content="Close" Click="CloseButton_Click" Command="{Binding CloseCommand}" Background="White" BorderThickness="0" Width="80"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</local:MyWindow>
